{
  "version": 2,
  "name": "ab-auto-ecommerce",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "functions": {
    "index.js": {
      "maxDuration": 30
    }
  },
  "framework": "adonisjs"
}
