{
  "id": "ab-auto-app",
  "name": "AB-AUTO E-commerce Platform",
  "description": "Plateforme e-commerce pour pièces automobiles avec gestion des vendeurs, produits et commandes",
  "keywords": ["ecommerce", "automotive", "marketplace", "adonisjs", "vuejs"],
  "repository": "https://github.com/PaixSalim/ab-auto.git",
  "logo": "https://votre-domaine.com/logo.png",
  "website": "https://votre-domaine.com",
  "success_url": "https://votre-domaine.com/deploy-success",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3333",
    "HOST": "0.0.0.0",
    "APP_KEY": "your-app-key-here",
    "SESSION_DRIVER": "redis",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "localhost",
    "DB_PORT": "3306",
    "DB_USER": "hotinger_user",
    "DB_PASSWORD": "your-db-password",
    "DB_NAME": "hotinger_db",
    "REDIS_HOST": "localhost",
    "REDIS_PORT": "6379",
    "REDIS_PASSWORD": "",
    "ASSET_URL": "https://votre-app.hotinger.dev",
    "CACHE_VIEWS": "true"
  },
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "installCommand": "npm ci --production",
    "startCommand": "node server.js"
  },
  "scaling": {
    "min_instances": 1,
    "max_instances": 3,
    "target_cpu_usage": 70,
    "target_memory_usage": 80
  },
  "resources": {
    "cpu": "shared",
    "memory": "shared",
    "storage": "10GB"
  },
  "domains": [
    {
      "domain": "votre-domaine.hotinger.dev",
      "type": "primary"
    }
  ],
  "health_check_path": "/health",
  "zero_downtime": true,
  "auto_deploy": true,
  "environment_variables": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "PORT",
      "value": "3333"
    }
  ]
}
